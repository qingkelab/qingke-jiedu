# ===== link2post 配置示例 =====
# 复制为 .env 后填写；未配置 key 时文案生成会明确报错（不再有示例文案）。

PORT=4780

# ---- 文案引擎 ----
# 可选值：deepseek | openai
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（或任意 OpenAI-compatible 端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 渲染 ----
# MAX_PDF_PAGES=30        # PDF 最多转图页数
# PDF_SCALE=2             # PDF 渲染清晰度
# WEB_VIEWPORT_WIDTH=1280
# WEB_DEVICE_SCALE=2
# WEB_SEGMENT_HEIGHT=4000 # 长网页分段高度（CSS 像素）

# ---- 文案约束 ----
# MAX_COPY_CHARS=1000     # 解读文案字数上限
# MAX_TITLE_CHARS=20      # 标题字数上限

# ---- 同步到公众号「贴图」（可选，需认证服务号）----
# 配置后「同步到公众号」会把选中图片生成贴图草稿（newspic）；不配置则降级为「打包下载图片」
WECHAT_APP_ID=
WECHAT_APP_SECRET=
